# ==========================================
# DOCKER COMPOSE PROJECT NAME
# ==========================================
# 
# This groups all containers under a project name
# Makes it easier to manage related containers

COMPOSE_PROJECT_NAME=sparklab

# Spark Lab Environment Configuration
# ==========================================
# 
# This file contains all environment variables for the Spark Lab.
# Copy this file to .env and customize values as needed.
#
# IMPORTANT:
# - Never commit .env to version control (it's in .gitignore)
# - This file (.env.example) serves as documentation
# - All variables have sensible defaults
#
# QUICK START:
# 1. cp .env.example .env
# 2. Edit .env with your preferences
# 3. Run: task setup

# ==========================================
# SPARK VERSION
# ==========================================
# The Apache Spark version to use
# Available versions: Check Docker Hub for apache/spark tags
# Default: 3.5.5 (latest stable as of 2024)
SPARK_VERSION=3.5.5

# ==========================================
# NETWORK & PORT CONFIGURATION
# ==========================================
# 
# These ports are mapped from containers to your host machine.
# Change these if you have port conflicts on your machine.
# 
# Format: HOST_PORT:CONTAINER_PORT
# Access services at: http://localhost:HOST_PORT

# Spark Master - Internal protocol port (7077)
# Used for Spark internal communication between master and workers
# Default: 7077
SPARK_MASTER_PORT=7077

# Spark Master Web UI - View cluster status, jobs, workers
# URL: http://localhost:8180
# Default: 8080 (Spark's built-in default; override here if that port is taken)
SPARK_MASTER_WEBUI_PORT=8180

# Spark Worker 1 - Internal protocol port
# Default: 8881
SPARK_WORKER_1_PORT=8881

# Spark Worker 1 Web UI - View worker status and executors
# URL: http://localhost:8081
# Default: 8081
SPARK_WORKER_1_UI_PORT=8081

# Spark Worker 2 - Internal protocol port
# Default: 8882
SPARK_WORKER_2_PORT=8882

# Spark Worker 2 Web UI - View worker status and executors
# URL: http://localhost:8082
# Default: 8082
SPARK_WORKER_2_UI_PORT=8082

# ==========================================
# JUPYTER NOTEBOOK CONFIGURATION
# ==========================================

# Spark Connect server port (runs on the Spark container, not in Jupyter)
# Notebooks connect via: sc://spark-single:<port> (or spark-master in cluster mode)
# This is the ONLY Spark used by notebooks — Jupyter is a thin client.
# Default: 15002
SPARK_CONNECT_PORT=15002

# Jupyter Notebook port
# URL: http://localhost:8888
# Default: 8888
JUPYTER_PORT=8888

# Jupyter authentication token
# Used in the URL: http://localhost:8888/?token=YOUR_TOKEN
# Change this to a secure value for production use
# Default: spark-lab-token
JUPYTER_TOKEN=spark-lab-token

# ==========================================
# RESOURCE ALLOCATION
# ==========================================
# 
# These settings control how much CPU and memory each worker gets.
# Adjust based on your machine's available resources.
# 
# IMPORTANT MEMORY GUIDELINES:
# - Each worker needs: SPARK_WORKER_MEMORY + overhead (~20%)
# - Master needs: ~2GB minimum
# - Jupyter needs: ~2GB
# - Leave some RAM for your OS (at least 4GB)
# 
# Example for 16GB RAM machine:
#   SPARK_WORKER_MEMORY=3g (2 workers = 6GB)
#   + Master overhead ~2GB
#   + Jupyter ~2GB
#   + OS buffer ~4GB
#   = 14GB used (good)

# CPU cores per worker
# Each worker can run this many tasks in parallel
# Default: 2
SPARK_WORKER_CORES=2

# Memory per worker (format: number + g/m/k)
# Examples: 512m, 2g, 4g, 8g
# Default: 2g
SPARK_WORKER_MEMORY=4g

# ==========================================
# EXECUTOR / APPLICATION RESOURCE CONFIGURATION
# ==========================================
#
# These control how much memory/CPUs each *application* consumes within the
# cluster, and the default parallelism. They are rendered into
# config/spark-defaults.conf by `task config:render`, so EVERY job submission
# (task submit, task generate) picks them up automatically — no need to edit
# the Spark config file.
#
# NOTE: changing these only requires `task config:render`, then re-submit.
# They take effect at submit time (no cluster restart needed).

# Memory for the driver JVM (the "brain" of each application)
# Default: 2g
SPARK_DRIVER_MEMORY=2g

# Off-heap/native overhead added on top of driver memory
# Default: 512m
SPARK_DRIVER_MEMORY_OVERHEAD=512m

# Heap memory for each executor JVM
# Override at submit time to make jobs spill more/less
# Default: 2g
SPARK_EXECUTOR_MEMORY=2g

# Off-heap/native (and PySpark/UDF) overhead per executor
# Default: 512m
SPARK_EXECUTOR_MEMORY_OVERHEAD=512m

# Number of cores each executor uses (task parallelism per executor)
# Default: 2
SPARK_EXECUTOR_CORES=2

# Default number of partitions for shuffles and parallel operations
# Default: 4
SPARK_DEFAULT_PARALLELISM=4

# ==========================================
# HOST CONFIGURATION
# ==========================================
# 
# These are used for internal Docker networking.
# Only change if you modify docker-compose network settings.

# Spark Master hostname (internal Docker network)
# Workers use this to connect to master
# Default: spark-master
SPARK_MASTER_HOST=spark-master

# ==========================================
# DATA GENERATION CONFIGURATION
# ==========================================
# 
# Control the size of generated sample datasets
# These are used by examples/generate_data.py

# Number of user records to generate
# Default: 1000 (small: 100, medium: 1000, large: 10000)
USERS_COUNT=1000

# Number of product records to generate
# Default: 500 (small: 50, medium: 500, large: 5000)
PRODUCTS_COUNT=500

# Number of order records to generate
# Default: 10000 (small: 1000, medium: 10000, large: 100000)
ORDERS_COUNT=10000

# ==========================================
# APPLICATION CONFIGURATION
# ==========================================

# Default application name prefix
# Spark applications will be named: {APP_NAME}-script-name
# Default: Spark-Lab
APP_NAME=Spark-Lab

# ==========================================
# TROUBLESHOOTING
# ==========================================
#
# Common issues and solutions:
#
# 1. "Port already in use" error:
#    - Change the conflicting port above
#    - Or stop the service using that port
#
# 2. "Out of memory" errors:
#    - Reduce SPARK_WORKER_MEMORY
#    - Reduce number of workers in docker-compose.yml
#
# 3. "Connection refused" to Spark:
#    - Check if containers are running: docker ps
#    - Check logs: task logs
#    - Verify network: docker network ls | grep spark
#
# 4. Jupyter token not working:
#    - Make sure JUPYTER_TOKEN is set
#    - Check container logs: docker logs jupyter
#
# ==========================================
# PRODUCTION NOTES
# ==========================================
#
# For production deployment:
# 1. Change JUPYTER_TOKEN to a secure random string
# 2. Enable authentication in Jupyter
# 3. Use Docker secrets for sensitive values
# 4. Enable SSL/TLS for web interfaces
# 5. Configure proper firewall rules
# 6. Set resource limits in docker-compose.yml
# 7. Enable persistent storage for data directory
# 8. Configure log aggregation
# 9. Set up monitoring (Prometheus/Grafana)
# 10. Enable audit logging
#
# ==========================================
